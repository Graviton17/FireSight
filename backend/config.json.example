{
  "database": {
    "supabase_url": "https://your-project.supabase.co",
    "supabase_key": "your-anon-key",
    "supabase_service_role_key": "your-service-role-key"
  },
  "server": {
    "port": 8000,
    "base_url": "http://localhost:8000",
    "cors_origins": [
      "http://localhost:5173"
    ],
    "environment": "development",
    "auto_reload": true
  },
  "camera": {
    "base_url": "http://192.168.1.50:8080",
    "snapshot_path": "/shot.jpg",
    "username": "",
    "password": "",
    "timeout_seconds": 3,
    "device_id": "",
    "location_max_accuracy_m": 50,
    "location_timeout_seconds": 1.5,
    "location_cache_seconds": 60
  },
  "detection": {
    "enabled": true,
    "model_path": "models/Fire-Detection-Siglip2",
    "fire_labels": ["fire", "smoke"],
    "threshold": 0.7,
    "force_fire": false,
    "timeout_seconds": 4,
    "device": "cpu"
  },
  "logging": {
    "log_level": "INFO"
  }
}
